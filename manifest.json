{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_extName__",
  "version": "1.2.1",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "alarms",
    "identity",
    "downloads",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "oauth2": {
    "client_id": "53595916112-9a2shv02h83ue53q5mpft1hkc81oeb3s.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "commands": {
    "add-selected-word": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "__MSG_cmd_add_selected_word__"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_cmd_translate_selection__"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmd_open_side_panel__"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "__MSG_cmd_execute_action__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "i18n-en.js",
        "i18n.js",
        "constants.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
